{
  "name": "trip-move",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "a[href^='#trip/'] >> visible=true" },
    { "wait_for": "ul[aria-label='Bookings']" },
    { "click": "ul[aria-label='Bookings'] button[data-booking] >> visible=true >> nth=-1" },
    { "wait_for": "[data-testid=booking-detail]" },
    { "click": "[data-testid=booking-detail] button[aria-label^='More options for '] >> visible=true" },
    { "wait_for": "button[aria-label^='Move ']" },
    { "screenshot": "booking-options" },
    { "click": "button[aria-label^='Move '] >> visible=true >> nth=-1" },
    { "wait_for": "[role='dialog'] select" },
    { "screenshot": "move-booking" }
  ]
}
