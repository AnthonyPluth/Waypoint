{
  "name": "booking-form",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "button:has-text('Add a booking'), button[aria-label='Add']" },
    { "click_if_present": "[role='group'][aria-label='Add'] button:has-text('Add a booking')" },
    { "wait_for": "form[data-editor]" },
    { "expect_text": { "selector": "form[data-editor]", "text": "When and where" } },
    { "expect_text": { "selector": "form[data-editor]", "text": "More details" } },
    { "scroll_to": "form[data-editor]" },
    { "screenshot": "flight" },
    { "fill": { "selector": "input[placeholder^='JFK']", "text": "Nowhere" } },
    { "click": "form[data-editor] button[type=submit]" },
    { "wait_for": "[data-error]" },
    { "expect_text": { "selector": "form[data-editor]", "text": "Choose the airport it leaves from" } },
    { "scroll_to": "[data-error]" },
    { "screenshot": "flight-errors" },
    { "select": { "selector": "label:has(> span:text-is('What is it')) select", "index": 1 } },
    { "expect_text": { "selector": "form[data-editor]", "text": "Hotel name" } },
    { "scroll_to": "form[data-editor]" },
    { "screenshot": "hotel" },
    { "select": { "selector": "label:has(> span:text-is('What is it')) select", "index": 2 } },
    { "expect_text": { "selector": "form[data-editor]", "text": "Pick-up place" } },
    { "scroll_to": "form[data-editor]" },
    { "screenshot": "car" },
    { "select": { "selector": "label:has(> span:text-is('What is it')) select", "index": 4 } },
    { "wait_for": "fieldset[data-itinerary]" },
    { "scroll_to": "form[data-editor]" },
    { "screenshot": "cruise" },
    { "select": { "selector": "label:has(> span:text-is('What is it')) select", "index": 6 } },
    { "wait_for": "label:has(> span:text-is('Country')) select" },
    { "scroll_to": "form[data-editor]" },
    { "screenshot": "past-visit" }
  ]
}
