{
  "name": "trip-inline-edit",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "a[href^='#trip/'] >> visible=true" },
    { "wait_for": "ul[aria-label='Bookings']" },
    { "screenshot": "header-closed" },
    { "click": "button[aria-label='Edit trip details']" },
    { "wait_for": "form[aria-label='Edit trip details']" },
    { "screenshot": "header-form" },
    { "click": "form[aria-label='Edit trip details'] button:has-text('Cancel')" },
    { "click": "ul[aria-label='Bookings'] button[aria-label^='Edit '] >> nth=-1" },
    { "wait_for": "li[aria-label='Edit booking'], [data-slot='sheet'] form" },
    { "screenshot": "edit-booking" }
  ]
}
