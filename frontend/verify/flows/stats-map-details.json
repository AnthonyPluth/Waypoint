{
  "name": "stats-map-details",
  "page": "stats",
  "steps": [
    {
      "expect_text": {
        "selector": "h1",
        "text": "Stats"
      }
    },
    {
      "wait_for": "[data-kind='country']"
    },
    {
      "scroll_to": "#stats-map-slot"
    },
    {
      "click": "[data-hit][data-kind='route'][data-label^='JFK – MCO']"
    },
    {
      "wait_for": "[data-testid='map-trips']"
    },
    {
      "screenshot": "route-trips"
    },
    {
      "click": "[data-dot='JFK']"
    },
    {
      "expect_text": {
        "selector": "#stats-map-slot",
        "text": "JFK"
      }
    },
    {
      "screenshot": "airport"
    },
    {
      "click": "[data-hit][data-kind='country'] >> nth=0"
    },
    {
      "wait_for": "[data-testid='map-trips']"
    },
    {
      "screenshot": "country"
    }
  ]
}
