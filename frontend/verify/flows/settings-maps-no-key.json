{
  "name": "settings-maps-no-key",
  "page": "settings",
  "mapkit": "none",
  "steps": [
    { "goto": "#settings/travel" },
    { "expect_text": { "selector": "h1", "text": "Travel preferences" } },
    { "wait_for": "[data-testid='maps-row']" },
    { "expect_text": { "selector": "[data-testid='maps-row']", "text": "Off: this server has no MapKit key, so Waypoint shows no maps or route replays." } },
    { "expect_text": { "selector": "[data-testid='maps-row']", "text": "How to turn on maps" } },
    { "scroll_to": "[data-testid='maps-row']" },
    { "screenshot": "maps-off" }
  ]
}
