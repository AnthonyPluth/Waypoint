{
  "name": "trip-route-replay-mapkit-blocked",
  "page": "trips",
  "mapkit": "blocked",
  "allow_console": [
    "net::ERR_BLOCKED_BY_CLIENT"
  ],
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "a[href^='#trip/']:has-text('Orlando') >> visible=true" },
    { "wait_for": "h1:has-text('Orlando')" },
    { "wait_for": "[data-testid='trip-summary']" },
    { "expect_absent": "section[aria-label='Route replay']" },
    { "expect_absent": "[data-mapkit]" },
    { "expect_absent": "p[role='status']:has-text('The map couldn’t load')" },
    { "screenshot": "replay-hidden" }
  ]
}
