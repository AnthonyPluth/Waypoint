{
  "name": "past-trip-page",
  "page": "trips",
  "signed_in": true,
  "allow_console": ["Applying inline style violates the following Content Security Policy", "Blocked script execution in"],
  "steps": [
    {"goto": "#trip/7"},
    {"wait_for": "[data-testid=trip-hero]"},
    {"expect_text": {"selector": "h1", "text": "Trip to Denver"}},
    {"expect_text": {"selector": "[data-testid=past-trip] >> text=/^13 photos$/", "text": "13 photos"}},
    {"wait_for": "[data-testid=photo-days] [data-day]"},
    {"screenshot": "with-photos"},
    {"click": "button[aria-label='Trip options']"},
    {"wait_for": "[role=menu]"},
    {"expect_text": {"selector": "[role=menu]", "text": "Merge another trip"}},
    {"screenshot": "options"},
    {"press": {"selector": "[role=menu]", "key": "Escape"}},
    {"click": "button:has-text('Show all')"},
    {"screenshot": "all-days"},
    {"click": "[data-testid=photo-days] [data-photo] >> nth=0"},
    {"wait_for": "[role=dialog]"},
    {"screenshot": "photo"},
    {"press": {"selector": "[role=dialog]", "key": "Escape"}},
    {"goto": "#trip/1"},
    {"wait_for": "[data-testid=no-photos]"},
    {"expect_text": {"selector": "h1", "text": "Trip to Paris"}},
    {"press": {"selector": "input[aria-label='Position along the route']", "key": "End"}},
    {"screenshot": "no-photos"},
    {"fake_photo_limit": 2},
    {"goto": "#trip/3"},
    {"wait_for": "[data-testid=photo-days] [data-day]"},
    {"expect_text": {"selector": "h1", "text": "Trip to Orlando"}},
    {"press": {"selector": "input[aria-label='Position along the route']", "key": "End"}},
    {"screenshot": "two-photos"}
  ]
}
