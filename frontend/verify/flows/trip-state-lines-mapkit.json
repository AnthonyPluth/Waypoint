{
  "name": "trip-state-lines-mapkit",
  "page": "trips",
  "mapkit": "fake",
  "steps": [
    {
      "expect_text": {
        "selector": "h1",
        "text": "Trips"
      }
    },
    {
      "click": "a[href^='#trip/']:has-text('Denver') >> visible=true"
    },
    {
      "wait_for": "h1:has-text('Denver')"
    },
    {
      "wait_for": "section[aria-label='Route replay'] [data-testid='replay-map'] [data-mapkit]"
    },
    {
      "press": {
        "selector": "input[aria-label='Position along the route']",
        "key": "End"
      }
    },
    {
      "wait_for": "[data-mapkit] polyline[stroke-dasharray]"
    },
    {
      "wait_for": "[data-mapkit] [data-shield] svg"
    },
    {
      "expect_text": {
        "selector": "[aria-label='Map key']",
        "text": "State line"
      }
    },
    {
      "screenshot": "state-lines"
    }
  ]
}
