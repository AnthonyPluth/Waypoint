{
  "name": "review-phone-panes",
  "page": "review",
  "viewports": [
    "phone"
  ],
  "steps": [
    {
      "expect_text": {
        "selector": "h1",
        "text": "Review"
      }
    },
    {
      "wait_for": "[data-testid='review-item']"
    },
    {
      "click": "button:has-text('Add by hand') >> visible=true >> nth=0"
    },
    {
      "wait_for": "[role='dialog'] [data-testid='preview-html'][aria-busy='false']"
    },
    {
      "expect_text": {
        "selector": "[role='dialog']",
        "text": "Add to my trips"
      }
    },
    {
      "screenshot": "email-pane"
    },
    {
      "click": "[role='dialog'] button:has-text('Booking')"
    },
    {
      "wait_for": "[role='dialog'] label:has-text('Provider') input"
    },
    {
      "screenshot": "booking-pane"
    },
    {
      "fill": {
        "selector": "[role='dialog'] label:has-text('Provider') input",
        "text": "Seaside Stays Ltd"
      }
    },
    {
      "screenshot": "booking-pane-typing"
    }
  ]
}
