{
  "name": "trip-done-manage",
  "page": "trips",
  "steps": [
    {"expect_text": {"selector": "h1", "text": "Trips"}},
    {"click": "a[href^='#trip/']:has-text('Orlando') >> visible=true"},
    {"wait_for": "[data-testid=past-trip]"},
    {"wait_for": "section[aria-label='Done with this trip']"},
    {"scroll_to": "section[aria-label='Done with this trip']"},
    {"screenshot": "past-not-done"},
    {"goto": "#trips"},
    {"expect_text": {"selector": "h1", "text": "Trips"}},
    {"wait_for": "a[href^='#trip/'] >> visible=true"},
    {"scroll_to": "ul[aria-label='Past trips in 2026'] > li:last-child"},
    {"wait_for": "ul[aria-label='Past trips in 2025'] a"},
    {"click": "a[href^='#trip/']:has-text('San Francisco (May 2025)') >> visible=true"},
    {"wait_for": "[data-testid=past-trip]"},
    {"expect_text": {"selector": "main", "text": "Trip to San Francisco"}},
    {"screenshot": "past-done"}
  ]
}
