{
  "name": "trip-route-replay-mapkit-fallback",
  "page": "trips",
  "mapkit": "error",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "a[href^='#trip/']:has-text('Orlando') >> visible=true" },
    { "wait_for": "h1:has-text('Orlando')" },
    { "wait_for": "section[aria-label='Route replay'] [data-testid='replay-map'] [data-mapkit]" },
    { "screenshot": "replay-on-mapkit" },
    { "wait_for": "p[role='status']:has-text('The map couldn’t load')", "timeout": 15000 },
    { "expect_absent": "section[aria-label='Route replay']" },
    { "expect_absent": "[data-mapkit]" },
    { "expect_absent": "input[aria-label='Position along the route']" },
    { "screenshot": "replay-failed" }
  ]
}
