{
  "name": "offline-panels-app",
  "page": "upcoming",
  "viewports": ["phone"],
  "steps": [
    { "fake_shell": "saved" },
    { "reload": true },
    { "wait_for": "[data-testid='offline-pill']" },
    { "screenshot": "upcoming-saved" },
    { "click": "[data-testid='offline-pill']" },
    { "wait_for": "h1:has-text('Offline & notifications')" },
    { "fake_shell": "off" },
    { "reload": true },
    { "goto": "#upcoming" },
    { "wait_for": "main h1" },
    { "expect_absent": "[data-testid='offline-pill']" },
    { "screenshot": "upcoming-saving-off" }
  ]
}
