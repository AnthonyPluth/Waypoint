{
  "name": "review-dismiss-undo",
  "page": "review",
  "steps": [
    {
      "wait_for": "[data-testid='review-item']"
    },
    {
      "click": "[data-testid='action-menu'] summary >> nth=0"
    },
    {
      "click": "button[aria-label^='Dismiss']:visible >> nth=0"
    },
    {
      "wait_for": "[data-sonner-toast]"
    },
    {
      "expect_text": {
        "selector": "[data-sonner-toast]",
        "text": "Undo"
      }
    },
    {
      "screenshot": "toast"
    },
    {
      "click": "[data-sonner-toast] button:has-text('Undo')"
    },
    {
      "wait_for": "[data-testid='review-item']"
    }
  ]
}
