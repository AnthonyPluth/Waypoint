{
  "name": "trip-route-replay",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "a[href^='#trip/']:has-text('Orlando') >> visible=true" },
    { "wait_for": "h1:has-text('Orlando')" },
    { "wait_for": "section[aria-label='Route replay'] [data-testid='replay-map']" },
    { "expect_text": { "selector": "[data-testid='stop-list']", "text": "Orlando" } },
    { "press": { "selector": "input[aria-label='Position along the route']", "key": "Home" } },
    { "wait_for": "[data-label='New York'][data-visible='true']" },
    { "screenshot": "replay-start" },
    { "fill": { "selector": "input[aria-label='Position along the route']", "text": "2000" } },
    { "wait_for": "svg[data-zoomed='true']" },
    { "screenshot": "replay-zoomed" },
    { "press": { "selector": "input[aria-label='Position along the route']", "key": "End" } },
    { "wait_for": "[data-testid='stop-list']" },
    { "wait_for": "[data-testid='stop-list'] li:last-child[data-current='true']" },
    { "expect_text": { "selector": "[data-testid='stop-list'] li:last-child", "text": "New York" } },
    { "screenshot": "replay-end" }
  ]
}
