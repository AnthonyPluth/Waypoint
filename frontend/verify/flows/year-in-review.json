{
  "name": "year-in-review",
  "page": "stats",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Stats" } },
    { "click_if_present": "button:has-text('Filters')" },
    { "click": "[role='group'][aria-label='Year'] button >> nth=1" },
    { "click_if_present": "[role='dialog'] button[aria-label='Close']" },
    { "click": "button:has-text('in review')" },
    { "expect_text": { "selector": "[data-testid=year-in-review]", "text": "YOU TRAVELLED" } },
    { "screenshot": "distance" },
    { "click": "button:has-text('Next')" },
    { "click": "button:has-text('Next')" },
    { "screenshot": "countries" },
    { "click": "button:has-text('Next')" },
    { "click": "button:has-text('Next')" },
    { "click": "button:has-text('Next')" },
    { "expect_text": { "selector": "[data-testid=year-in-review]", "text": "parking day" } },
    { "screenshot": "parking" },
    { "click": "button:has-text('Next')" },
    { "wait_for": "[data-testid=year-in-review] img[alt^='Map of']" },
    { "screenshot": "map" },
    { "click": "button:has-text('Next')" },
    { "wait_for": "[data-testid=save-card]" },
    { "screenshot": "save-image" },
    { "download": { "selector": "button:has-text('Save as image')", "name": "saved-image" } }
  ]
}
