    },
    {
      "fill": {
        "selector": "[role='dialog'] label:has-text('To (airport code)') input",
        "text": "DEN"
      }
    },
    {
      "click": "[role='dialog'] button:has-text('Add another leg or booking')"
    },
    {
      "click": "[role='dialog'] button:has-text('Add another leg or booking')"
    },
    {
      "expect_text": {
        "selector": "[role='dialog']",
        "text": "Flight 3 of 3"
      }
    },
    {
      "screenshot": "three-legs"
    },
    {
      "scroll_to": "[role='dialog'] button:has-text('Add 3 flights')"
    },
    {
      "screenshot": "three-legs-end"
    }
  ]
