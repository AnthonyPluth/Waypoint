{
  "name": "past-trip-page-desktop",
  "page": "trips",
  "viewports": ["desktop", "laptop"],
  "signed_in": true,
  "allow_console": ["Applying inline style violates the following Content Security Policy", "Blocked script execution in"],
  "steps": [
    {"goto": "#trip/7"},
    {"wait_for": "[data-testid=trip-hero]"},
    {"expect_text": {"selector": "h1", "text": "Trip to Denver"}},
    {"wait_for": "[data-testid=trip-column] [data-testid=trip-summary]"},
    {"expect_text": {"selector": "[data-testid=trip-column]", "text": "13 photos"}},
    {"expect_text": {"selector": "h2", "text": "Photos by day"}},
    {"wait_for": "[data-testid=photo-days] [data-day]"},
    {"screenshot": "columns"},
    {"wait_for": "[data-testid=trip-column] [role=group][aria-label^='Trip map'] [data-pin]"},
    {"click": "[data-testid=trip-column] button[aria-label='Replay trip']"},
    {"wait_for": "[data-testid=trip-column] input[aria-label='Position along the route']"},
    {"screenshot": "replay"},
    {"press": {"selector": "[data-testid=trip-column] input[aria-label='Position along the route']", "key": "End"}},
    {"wait_for": "[data-testid=trip-column] [role=group][aria-label^='Trip map'] [data-pin]"},
    {"click": "button:has-text('Show all')"},
    {"scroll_to": "[data-day] >> nth=4"},
    {"expect_text": {"selector": "[data-testid=trip-column]", "text": "Jane Doe"}},
    {"screenshot": "all-days"},
    {"click": "button:has-text('Open gallery')"},
    {"wait_for": "#trip-photos-gallery [data-photo]"},
    {"screenshot": "gallery"},
    {"click": "#trip-photos-gallery [data-photo] >> nth=0"},
    {"wait_for": "[role=dialog]"},
    {"press": {"selector": "[role=dialog]", "key": "Escape"}},
    {"click": "button:has-text('Close gallery')"},
    {"goto": "#trip/1"},
    {"wait_for": "[data-testid=no-photos]"},
    {"expect_text": {"selector": "h1", "text": "Trip to Paris"}},
    {"press": {"selector": "input[aria-label='Position along the route']", "key": "End"}},
    {"screenshot": "no-photos"}
  ]
}
