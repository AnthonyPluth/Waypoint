{
  "name": "trips-search",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "wait_for": "a[href^='#trip/'] >> visible=true" },
    { "screenshot": "small-archive" },
    { "fake_archive": 400 },
    { "reload": true },
    { "expect_text": { "selector": "[role=status]", "text": "4" } },
    { "screenshot": "several-hundred" },
    { "fill": { "selector": "input[type=search]", "text": "Lisbon" } },
    { "expect_text": { "selector": "[role=status]", "text": " OF " } },
    { "screenshot": "searched" },
    { "click": "[role='group'][aria-label='Show'] button:has-text('Past')" },
    { "click_if_present": "button:has-text('Filters')" },
    { "click": "[role='group'][aria-label='Year'] button >> nth=1" },
    { "screenshot": "filtered" },
    { "reload": true },
    { "expect_text": { "selector": "[role=status]", "text": " OF " } },
    { "click": "button:has-text('Clear filters')" },
    { "screenshot": "cleared" }
  ]
}
