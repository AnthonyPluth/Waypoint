{
  "name": "flight-card",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "click": "a[href^='#trip/']:has-text('Auckland') >> visible=true" },
    { "wait_for": "article[data-kind='flight'] [data-code='origin']" },
    { "expect_text": { "selector": "article[data-hero]", "text": "Your flight to" } },
    { "scroll_to": "article[data-hero]" },
    { "screenshot": "trip-flight" },
    { "goto": "#design" },
    { "expect_text": { "selector": "#design-flight-card", "text": "Flight card" } },
    { "wait_for": "article[data-state='scheduled']" },
    { "wait_for": "article[data-state='boarding']" },
    { "wait_for": "article[data-state='delayed']" },
    { "wait_for": "article[data-state='in-the-air']" },
    { "wait_for": "article[data-state='landed']" },
    { "wait_for": "article[data-state='cancelled']" },
    { "wait_for": "article[data-state='diverted']" },
    { "expect_text": { "selector": "article[aria-label$='no live status yet']", "text": "Live status starts 1 day before." } },
    { "expect_text": { "selector": "article[data-state='landed']", "text": "You are in" } },
    { "expect_text": { "selector": "article[data-state='delayed']", "text": "DELAYED" } },
    { "expect_text": { "selector": "article[data-state='delayed']", "text": "Originally" } },
    { "scroll_to": "#design-flight-card" },
    { "screenshot": "eight-states" }
  ]
}
