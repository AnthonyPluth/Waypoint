    },
    {
      "click": "[data-dot='JFK']"
    },
    {
      "click": "[data-zoom='in']"
    },
    {
      "click": "[data-zoom='in']"
    },
    {
      "click": "[data-zoom='in']"
    },
    {
      "wait_for": "[data-kind='state']"
    },
    {
      "screenshot": "zoomed-into-states"
    },
    {
      "click": "[data-hit][data-kind='state'][data-label='New York']"
    },
    {
      "wait_for": "[data-testid='map-trips']"
    },
    {
      "screenshot": "state-trips"
    }
  ]
