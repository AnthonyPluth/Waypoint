{
  "name": "trip-destination",
  "page": "trips",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Trips" } },
    { "fake_destination": "Colorado & Texas" },
    { "reload": true },
    { "click": "a[href^='#trip/']:has-text('London') >> visible=true" },
    { "wait_for": "button[aria-label='Edit trip details']" },
    { "expect_text": { "selector": "main", "text": "United Kingdom" } },
    { "screenshot": "trip-subtitle" },
    { "click": "button[aria-label='Edit trip details']" },
    { "wait_for": "#trip-destination" },
    { "expect_text": { "selector": "main", "text": "Waypoint picks this from the places of your bookings" } },
    { "click": "button[aria-label='Suggest a destination with AI']" },
    { "wait_for": "input#trip-destination:not(:placeholder-shown)" },
    { "expect_text": { "selector": "main", "text": "You set this, so Waypoint won’t change it" } },
    { "screenshot": "suggested" },
    { "click": "form[aria-label='Edit trip details'] button:has-text('Save')" },
    { "expect_text": { "selector": "main", "text": "· Colorado & Texas" } },
    { "click": "button[aria-label='Edit trip details']" },
    { "fill": { "selector": "#trip-destination", "text": "" } },
    { "expect_text": { "selector": "main", "text": "Waypoint picks this from the places of your bookings" } },
    { "click": "form[aria-label='Edit trip details'] button:has-text('Save')" },
    { "expect_text": { "selector": "main", "text": "· United Kingdom" } },
    { "screenshot": "automatic-again" }
  ]
}
