{
  "name": "review-add-by-hand",
  "page": "review",
  "steps": [
    { "expect_text": { "selector": "h1", "text": "Review" } },
    { "wait_for": "[data-testid='review-item']" },
    { "click": "button:has-text('Add by hand') >> nth=0" },
    { "wait_for": "[data-testid='message-subject']" },
    { "wait_for": "[role='dialog'] [data-testid='preview-html'][aria-busy='false']" },
    { "screenshot": "message-with-form" },
    { "fill": { "selector": "[role='dialog'] label:has-text('Provider') input", "text": "Seaside Stays Ltd" } },
    { "press": { "selector": "[role='dialog'] label:has-text('Provider') input", "key": "Escape" } },
    { "wait_for": "[role='dialog']:has-text('Discard changes?')" },
    { "screenshot": "discard-prompt" },
    { "click": "button:has-text('Keep editing')" },
    { "click": "[role='dialog'] button:has-text('Hide the email')" },
    { "expect_text": { "selector": "[role='dialog']", "text": "Show the email" } },
    { "screenshot": "email-collapsed" }
  ]
}
