{
  "name": "ignore-undo",
  "page": "review",
  "steps": [
    {
      "fake_ignore": "example-air.example"
    },
    {
      "wait_for": "[data-testid='review-item']"
    },
    {
      "click": "[data-testid='review-item']:has(button[aria-label^='Not travel']) [data-testid='action-menu'] summary"
    },
    {
      "click": "button[aria-label^='Not travel']:visible"
    },
    {
      "wait_for": "[role='dialog']"
    },
    {
      "expect_text": {
        "selector": "[role='dialog']",
        "text": "You can undo this in Settings"
      }
    },
    {
      "screenshot": "confirm"
    },
    {
      "click": "[role='dialog'] button[type=submit]"
    },
    {
      "wait_for": "[data-sonner-toast] button:has-text('Undo')"
    },
    {
      "screenshot": "toast-with-undo"
    }
  ]
}
