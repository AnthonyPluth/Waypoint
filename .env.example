# Copy to .env and fill in. Keep .env private (it holds your client secret).
# Every variable you put here reaches Waypoint; the rest are listed in
# https://anthonypluth.github.io/waypoint/reference/configuration/

# The address you'll open Waypoint at. Register <this>/auth/callback as a redirect URI with your provider,
# and <this>/auth/signed-out as the post-logout redirect URI.
WAYPOINT_PUBLIC_URL=https://waypoint.example.com

# From your identity provider (Authentik, Authelia, Keycloak, Pocket ID, Google, Microsoft Entra, ...)
OIDC_ISSUER=https://auth.example.com/application/o/waypoint/
OIDC_CLIENT_ID=waypoint
OIDC_CLIENT_SECRET=

# Who may sign in: emails and/or groups (comma-separated). At least one is required. Everyone who signs in is part of
# one household: they share settings, backups and each other's loyalty IDs, and each sees the trips they're on.
OIDC_ALLOWED_EMAILS=you@example.com
OIDC_ALLOWED_GROUPS=

TZ=America/New_York

# Encrypts the mailbox access, travel IDs and API keys Waypoint saves. A long random string: openssl rand -base64 32
# Keep a copy somewhere safe (a password manager): without it, saved connections have to be entered again.
# Left empty, Waypoint makes a key file in ./data (secret.key) instead.
WAYPOINT_SECRET_KEY=

# Optional: Postgres instead of the built-in database. Leave empty to keep using the file in ./data.
# DATABASE_URL=postgresql://waypoint:password@db-host:5432/waypoint

# Optional: error reports and performance data to your own Sentry projects (all of it is sent once SENTRY_DSN is set).
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<server project>
# SENTRY_BROWSER_DSN=https://<key>@o<org>.ingest.us.sentry.io/<web app project>
# SENTRY_ENVIRONMENT=production
